{
  "name": "via443-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "relay": "pnpm --filter @via443/node start",
    "via443": "node packages/client/src/cli.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/cloudflare",
    "dev:cf": "pnpm --filter @via443/cloudflare dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
