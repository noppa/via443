// Local development by default: `pnpm dev` serves http://localhost:8787 and
// tunnels at http://<id>.localhost:8787. Deploy with `--env production`.
{
  "name": "via443",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "VIA443_DOMAIN": "localhost:8787",
    "VIA443_SCHEME": "http"
  },
  "durable_objects": {
    "bindings": [{ "name": "TUNNELS", "class_name": "TunnelDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "via443-accounts",
      "database_id": "local",
      "migrations_dir": "../../packages/server/migrations"
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "production": {
      // The apex serves the dashboard and /connect; the wildcard serves tunnels.
      // Both need proxied DNS records (an A/AAAA for the apex and a `*` record).
      "routes": [
        { "pattern": "via443.com/*", "zone_name": "via443.com" },
        { "pattern": "*.via443.com/*", "zone_name": "via443.com" }
      ],
      "vars": {
        "VIA443_DOMAIN": "via443.com",
        "VIA443_SCHEME": "https"
      },
      "durable_objects": {
        "bindings": [{ "name": "TUNNELS", "class_name": "TunnelDO" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "via443-accounts",
          // From `wrangler d1 create via443-accounts`.
          "database_id": "REPLACE_WITH_D1_DATABASE_ID",
          "migrations_dir": "../../packages/server/migrations"
        }
      ],
      "observability": { "enabled": true }
    }
  }
}
